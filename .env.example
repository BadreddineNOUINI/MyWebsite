# Auth admin
SESSION_SECRET=change-this-long-random-secret
ADMIN_USERNAME=admin
# Use either ADMIN_PASSWORD_HASH (recommended) or ADMIN_PASSWORD
ADMIN_PASSWORD_HASH=replace-with-sha256-hash
# ADMIN_PASSWORD=admin123

# PostgreSQL (recommended for structured data)
DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_SSL=true

# Netlify Blobs fallback
NETLIFY_BLOBS_SITE_ID=your-site-id
NETLIFY_BLOBS_TOKEN=your-personal-access-token
